@Tutorial(time: 20, projectFiles: "YachtDice-TutorialResources.zip") {
    @Intro(title: "Yacht Dice 프로젝트와 3D 에셋 준비하기") {
        완성하면 테이블 위 다섯 개의 주사위를 굴리고, 원하는 주사위를 고정해 점수표를 채울 수 있습니다. 먼저 Xcode에서 visionOS 프로젝트를 만들고 게임에 필요한 3D 에셋과 볼륨을 준비합니다.

        @Image(source: "9_Section 3_Step 1.png", alt: "완성된 Yacht Dice의 주사위 다섯 개와 점수표, Game Complete가 표시된 실행 화면입니다.")
    }

    @Section(title: "Xcode에서 visionOS 프로젝트 만들기") {
        @ContentAndMedia {
            Yacht Dice는 테이블과 주사위를 깊이 방향으로 배치하므로 처음부터 `Volume` 장면으로 시작합니다. Xcode의 visionOS App 템플릿을 사용하면 SwiftUI 장면, `RealityView`, Reality Composer Pro용 `RealityKitContent` 패키지를 같은 프로젝트에서 구성할 수 있습니다.
        }
        @Steps {
            @Step {
                Xcode 시작 화면의 `Create New Project…`를 선택합니다. 프로젝트가 이미 열려 있다면 메뉴의 `File > New > Project…`를 선택해도 됩니다.
                @Image(
                    source: "1_Section 1_Step 1.png",
                    alt: "Xcode 시작 화면의 Create New Project… 버튼이 강조되어 있습니다."
                )
            }
            @Step {
                다음으로 나타나는 화면에서 `visionOS > App` 템플릿을 선택합니다.
                @Image(
                    source: "1_Section 1_Step 2.png",
                    alt: "Xcode 템플릿 선택 화면에서 visionOS와 App 버튼이 강조되어 있습니다."
                )
            }
            @Step {
                Product Name을 `YachtDice`로 지정하고 Initial Scene은 `Volume`을 선택합니다. 이 튜토리얼에서는 별도의 Immersive Space를 사용하지 않습니다.
                @Image(
                    source: "1_Section 1_Step 3.png",
                    alt: "Xcode 프로젝트 설정 화면에서 Product Name에 YachtDice, Initial Scene에 Volume, Immersive Space Renderer에 None이 설정된 채로 강조되어 있습니다."
                )
            }
            @Step {
                프로젝트 생성 화면에서 Reality Composer Pro 콘텐츠가 포함되는 설정을 확인한 뒤 생성합니다. Project Navigator에서 `YachtDiceApp.swift`, `ContentView.swift`, `Packages/RealityKitContent`가 만들어졌는지 확인합니다.
                @Image(
                    source: "1_Section 1_Step 4.png",
                    alt: "Xcode Project Navigator에서 YachtDiceApp.swift, ContentView.swift, RealityKitContent 패키지의 위치가 표시된 화면입니다."
                )
            }
        }
    }

    @Section(title: "테이블과 D6 에셋 준비하기") {
        @ContentAndMedia {
            이 튜토리얼은 TabletopKit의 구조와 인터랙션에 집중하므로 직접 모델링하는 대신 테이블과 D6 에셋을 제공합니다. 이 페이지에서 `YachtDice-TutorialResources.zip`을 내려받으면 `dice`와 `table` 폴더를 사용할 수 있습니다.

            두 폴더를 Xcode가 만든 `RealityKitContent.rkassets` 안으로 복사합니다. `table` 폴더에는 `table.usda`가 참조하는 텍스처가 함께 들어 있으므로 폴더 전체를 유지해야 합니다. 이후 Swift 코드에서는 `realityKitContentBundle`을 통해 이 에셋들을 이름으로 직접 불러옵니다. 따라서 D6를 별도의 `Scene.usda` 안에 미리 배치할 필요는 없습니다.

            에셋을 넣을 실제 위치는 `Packages > RealityKitContent > Sources > RealityKitContent > RealityKitContent.rkassets`입니다. 이후에는 이 경로를 간단히 `RealityKitContent.rkassets`라고 부릅니다.
        }
        @Steps {
            @Step {
                이 페이지의 상단에서 `YachtDice-TutorialResources.zip`을 내려받고 압축을 풉니다.
                @Image(
                    source: "1_Section 2_Step 2.png",
                    alt: "튜토리얼 페이지 상단의 Project Files 다운로드 버튼이 강조되어 있습니다."
                )
            }
            @Step {
                Project Navigator에서 `Packages/RealityKitContent`를 펼쳐 `Sources/RealityKitContent/RealityKitContent.rkassets` 위치를 확인합니다.

                @Image(
                    source: "1_Section 2_Step 1.png",
                    alt: "Xcode Project Navigator에서 RealityKitContent 패키지와 Package.realitycomposerpro 파일의 위치를 보여주는 화면입니다."
                )
            }
            @Step {
                압축을 푼 파일 안에 있는 `dice`와 `table` 폴더를 `RealityKitContent.rkassets` 안으로 복사합니다. `table.usda`가 텍스처를 상대 경로로 참조하므로 `table` 폴더 전체를 그대로 옮깁니다.
                @Image(
                    source: "1_Section 2_Step 3.png",
                    alt: "Xcode Project Navigator의 RealityKitContent.rkassets에 dice와 table 에셋 폴더를 추가한 모습입니다."
                )
            }
            @Step {
                `Packages/RealityKitContent/Package.realitycomposerpro`를 열어 Reality Composer Pro에서 추가한 에셋이 보이는지 확인합니다. Project Navigator의 최종 경로가 `RealityKitContent.rkassets/table/table.usda`와 `RealityKitContent.rkassets/dice/D6.usdz`인지도 확인합니다. 이후 코드는 각각 `"table/table"`, `"dice/D6"`라는 이름으로 에셋을 로드합니다.

                `realityKitContentBundle`은 Xcode가 생성한 `RealityKitContent` 패키지의 resource bundle을 가리키며, `.rkassets` 안의 에셋을 이름으로 불러올 때 사용합니다.

                @Image(
                    source: "1_Section 2_Step 4.png",
                    alt: "Xcode Project Navigator에서 D6.usdz와 table.usda 에셋 파일을 확인하는 모습입니다."
                )
            }
        }
    }

    @Section(title: "볼륨의 시작 구조 확인하기") {
        @ContentAndMedia {
            볼륨 템플릿의 `WindowGroup`은 일반적인 SwiftUI 장면처럼 `ContentView`를 표시하면서 `.windowStyle(.volumetric)`으로 깊이를 가진 공간을 만듭니다. 앞에서 준비한 3D 에셋은 아직 화면에 올리지 않고, 먼저 이 공간과 게임의 루트 엔티티를 연결합니다.
        }
        @Steps {
            @Step {
                Xcode가 생성한 `YachtDiceApp.swift`를 엽니다. 여기서는 코드를 수정하지 않고 `WindowGroup`에 `ContentView`가 연결되고 `.windowStyle(.volumetric)`이 설정되어 있는지 확인합니다.
                @Code(name: "YachtDiceApp.swift", file: 01-01-YachtDiceApp-Basic.swift, reset: true)
            }
            @Step {
                `YachtDiceApp.swift`의 `WindowGroup`에서 `.windowStyle(.volumetric)` 바로 아래에 `.defaultSize(width:height:depth:in:)`를 추가합니다. 테이블과 주사위를 담을 볼륨의 초기 폭·높이·깊이를 각각 1m로 지정하며, 이는 3D 좌표계의 단위를 바꾸는 설정은 아닙니다.
                @Code(name: "YachtDiceApp.swift", file: 01-02-YachtDiceApp-Volume.swift, previousFile: 01-01-YachtDiceApp-Basic.swift)
            }
            @Step {
                `ContentView.swift`를 열어 Xcode가 만든 기본 `RealityView`를 확인합니다. 아직 수정하지 않습니다. 현재 `Scene` 에셋을 불러오는 부분과 `Enlarge RealityView Content` 버튼은 다음 섹션에서 게임의 루트 엔티티로 교체합니다.
                @Code(
                      name: "ContentView.swift", file: 01-00-ContentView-Template.swift, reset: true
                      ) {
                            @Image(
                                source: "1_Section 3_Step 3.png",
                                alt: "Xcode Volume 템플릿에서 Enlarge RealityView Content 버튼과 기본 3D 장면이 보이는 실행 화면입니다."
                            )
                        }
            }
        }
    }

    @Section(title: "게임의 RealityKit 루트 연결하기") {
        @ContentAndMedia {
            SwiftUI는 볼륨의 생명주기와 UI를 담당하고, RealityKit은 그 안의 3D 엔티티를 관리합니다. 테이블과 주사위를 하나의 장면으로 다루기 위해 공통 부모 엔티티를 `YachtGame`이 소유하도록 구성합니다.
        }
        @Steps {
            @Step {
                Xcode에서 새 Swift 파일 `YachtGame.swift`를 만들고 `YachtGame` 클래스와 `root` 프로퍼티를 선언합니다. `root`는 앞으로 테이블과 주사위가 연결될 RealityKit 엔티티 hierarchy의 시작점입니다.

                `YachtGame`은 이후 굴리기, Hold, 점수처럼 여러 뷰에서 공유할 게임 상태를 관리합니다. `@Observable`로 선언하면 SwiftUI가 이 객체의 상태 변화를 관찰할 수 있습니다.

                @Code(name: "YachtGame.swift", file: 01-03-YachtGame-Root.swift, reset: true)
            }
            @Step {
                `YachtDiceApp.swift`로 돌아가 App 타입 안에 `@State private var game` 프로퍼티를 추가하고, 기존 `ContentView()`에 `.environment(game)`을 연결합니다. `@State`가 하나의 `YachtGame` 인스턴스를 유지하고 환경을 통해 하위 뷰에 전달합니다. 따라서 `ContentView`와 이후의 결과 UI, 점수표가 모두 같은 게임 상태를 사용합니다.
                @Code(name: "YachtDiceApp.swift", file: 01-04-YachtDiceApp-Environment.swift, previousFile: 01-02-YachtDiceApp-Volume.swift)
            }
            @Step {
                `ContentView.swift`로 돌아가 템플릿의 `RealityView` 콘텐츠와 확대 버튼을 **게임용 `RealityView`로 교체**합니다. 파일 상단에 `@Environment(YachtGame.self)`를 선언하고, `RealityView`에서는 데모 `Scene` 대신 `game.root`를 추가합니다. 이후 생성하는 모든 3D content는 이 루트 아래에서 관리됩니다.
                @Code(name: "ContentView.swift", file: 01-05-ContentView-RealityView.swift, previousFile: 01-00-ContentView-Template.swift)
            }
        }
    }

    @Section(title: "실행해서 확인하기") {
        @ContentAndMedia {
            앱을 실행하면 1m³ 크기의 볼륨이 열립니다. 아직 테이블이나 주사위를 `root`에 추가하지 않았으므로 공간 안이 비어 있는 것이 정상입니다.

            현재 구조에서 SwiftUI는 볼륨을 만들고, `YachtGame.root`는 RealityKit 콘텐츠의 공통 부모가 됩니다. 다음 단원에서는 이 루트에 실제 테이블 엔티티를 추가하고 같은 엔티티를 TabletopKit의 tabletop으로 등록합니다.
        }
        @Steps {
            @Step {
                Simulator에서 앱을 실행합니다. 정상이라면 1m × 1m × 1m 볼륨 창 안이 비어 있어야 하며, 템플릿의 기본 3D 오브젝트와 `Enlarge RealityView Content` 버튼은 보이지 않아야 합니다. 테이블과 주사위는 아직 추가하지 않았으므로 나타나지 않는 것이 정상입니다.
                @Image(
                    source: "1_Section 5_Step 1.png",
                    alt: "visionOS Simulator에서 1m × 1m × 1m의 빈 볼륨 창이 열린 정상 실행 화면입니다."
                )
            }
        }
    }

    @Assessments {
        @MultipleChoice {
            Initial Scene을 `Volume`으로 선택하는 이유는 무엇인가요?
            @Choice(isCorrect: false) {
                `RealityKitContent` 패키지의 USDZ 에셋은 볼륨에서만 로드할 수 있기 때문입니다.
                @Justification(reaction: "다시 생각해보세요.") {
                    RealityKit 에셋을 사용하는 것 자체가 볼륨에만 제한되지는 않습니다.
                }
            }
            @Choice(isCorrect: true) {
                테이블과 주사위를 깊이 방향으로 배치할 3D 공간이 필요하기 때문입니다.
                @Justification(reaction: "정답입니다.") {
                    Yacht Dice의 RealityKit 콘텐츠는 volumetric window 안에 실제 깊이를 가진 좌표로 배치됩니다.
                }
            }
            @Choice(isCorrect: false) {
                TabletopKit이 항상 1m³ 크기의 장면을 요구하기 때문입니다.
                @Justification(reaction: "아닙니다.") {
                    1m³는 이 튜토리얼에서 정한 초기 볼륨 크기이며 TabletopKit의 고정 요구사항은 아닙니다.
                }
            }
        }
        @MultipleChoice {
            `YachtGame.root`의 역할은 무엇인가요?
            @Choice(isCorrect: false) {
                `TableSetup`의 tabletop, 좌석, 장비 상태를 저장하는 스냅샷입니다.
                @Justification(reaction: "아닙니다.") {
                    TabletopKit의 상태는 `TabletopGame`과 스냅샷이 관리하고, `root`는 RealityKit 엔티티입니다.
                }
            }
            @Choice(isCorrect: false) {
                사용자의 제스처를 `TabletopInteraction`으로 변환하는 delegate입니다.
                @Justification(reaction: "아닙니다.") {
                    제스처와 인터랙션의 연결은 이후 `.tabletopGame` 수식어와 `DiceInteraction`이 담당합니다.
                }
            }
            @Choice(isCorrect: true) {
                게임의 3D content를 한 RealityKit 엔티티 hierarchy 아래에서 관리하는 공통 부모입니다.
                @Justification(reaction: "맞아요.") {
                    이후 테이블과 주사위가 이 루트를 기준으로 같은 RealityKit 장면에 연결됩니다.
                }
            }
        }
        @MultipleChoice {
            D6를 `Scene.usda` 안에 미리 배치하지 않아도 되는 이유는 무엇인가요?
            @Choice(isCorrect: true) {
                `realityKitContentBundle`에서 `dice/D6` 에셋을 이름으로 직접 로드하기 때문입니다.
                @Justification(reaction: "정답입니다.") {
                    `RealityKitContent.rkassets`의 에셋은 패키지 resource에서 직접 불러올 수 있습니다.
                }
            }
            @Choice(isCorrect: false) {
                `TossableRepresentation.cube`가 시각적인 D6 mesh까지 자동으로 만들어 주기 때문입니다.
                @Justification(reaction: "아닙니다.") {
                    `TossableRepresentation`은 던지기 시뮬레이션을 위한 논리적 형태이고, 시각적인 mesh는 별도로 로드합니다.
                }
            }
            @Choice(isCorrect: false) {
                visionOS가 `die.face.*` SF Symbol을 자동으로 3D 모델로 변환하기 때문입니다.
                @Justification(reaction: "아닙니다.") {
                    SF Symbol은 이후 UI에서 사용할 수 있지만 3D D6 모델을 대신하지 않습니다.
                }
            }
        }
    }
}
