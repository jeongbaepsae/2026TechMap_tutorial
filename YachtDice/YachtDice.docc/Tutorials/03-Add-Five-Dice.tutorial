@Tutorial(time: 20) {
    @Intro(title: "D6 다섯 개를 장비로 추가하기") {
        한 개의 `Die`를 먼저 만들어 구조를 이해한 뒤, 같은 타입을 다섯 개로 확장합니다. 단원이 끝나면 테이블 위에 Yacht에 필요한 D6 다섯 개가 나란히 보입니다.
    }

    @Section(title: "첫 번째 주사위 만들기") {
        @ContentAndMedia {
            `EntityEquipment`는 **보이는 RealityKit 엔티티**, **고유 ID**, **초기 TabletopKit 상태**를 하나의 타입으로 묶습니다. `Die`는 `RealityKitContent.rkassets/dice/D6.usdz`를 `"dice/D6"` 경로로 직접 불러옵니다.

            D6 모델이 이미 정육면체처럼 보여도 TabletopKit이 시각적 메시만 보고 던지기 규칙을 추론하지는 않습니다. `TossableRepresentation.cube`는 던지기 시뮬레이션에서 사용할 **논리적인 형태와 face 구조**를 별도로 알려 줍니다.
        }
        @Steps {
            @Step {
                Xcode에서 새 Swift 파일 `Die.swift`를 만들고 `EntityEquipment`를 채택한 주사위 타입을 정의합니다. `ModelEntity.load(named:in:)`로 `"dice/D6"`를 `realityKitContentBundle`에서 불러온 뒤, ID, 초기 pose, 정육면체의 던지기 형태을 한 타입에 묶습니다. TabletopKit의 2D pose가 Spatial 타입을 사용하므로 이 파일에서도 `internal import Spatial`을 함께 사용합니다.
                @Code(name: "Die.swift", file: 03-01-Die-One.swift, reset: true)
            }
            @Step {
                `YachtGame.swift`로 이동해 기존 초기화 코드에 `dice` 배열과 주사위 한 개의 `setup.add(equipment:)`를 추가합니다. `TableSetup`에 등록된 순간부터 이 주사위는 단순한 3D 모델이 아니라 TabletopKit이 ID와 pose를 추적하는 장비가 됩니다.
                @Code(name: "YachtGame.swift", file: 03-02-YachtGame-OneDie.swift, previousFile: 02-06-YachtGame-Seat.swift)
            }
        }
    }

    @Section(title: "같은 구조를 다섯 개로 확장하기") {
        @ContentAndMedia {
            각 주사위는 같은 모델을 사용하지만 ID와 초기 위치는 달라야 합니다. 그래서 `index`를 ID와 x 위치 계산에 함께 사용합니다. index 1...5를 가운데 값 3을 기준으로 보정해 `-0.12, -0.06, 0, 0.06, 0.12m`에 배치하면 다섯 주사위가 테이블 중앙을 기준으로 대칭으로 놓입니다.
        }
        @Steps {
            @Step {
                `Die.swift`로 돌아와 기존 `initialState`의 고정 위치 계산을 **index 기반 위치 계산으로 교체**합니다. `index - 3`을 사용해 가운데 주사위를 x = 0에 두고 나머지를 좌우로 같은 간격만큼 배치합니다.
                @Code(name: "Die.swift", file: 03-03-Die-FiveLayout.swift, previousFile: 03-01-Die-One.swift)
            }
            @Step {
                `YachtGame.swift`를 열어 주사위 하나를 생성·등록하던 코드를 `(1...5).map`과 반복 등록 코드로 교체합니다. 다섯 주사위가 각각 고유 ID로 `TableSetup`에 추가됩니다.
                @Code(name: "YachtGame.swift", file: 03-04-YachtGame-FiveDice.swift, previousFile: 03-02-YachtGame-OneDie.swift)
            }
        }
    }

    @Section(title: "실행해서 확인하기") {
        @ContentAndMedia {
            테이블 위에 D6 다섯 개가 일정한 간격으로 보이면 성공입니다. 아직 잡아 던지는 인터랙션은 다음 단원에서 연결합니다.

            다섯 주사위는 같은 USDZ 모델과 던지기 shape를 공유하지만 각각 다른 `EquipmentIdentifier`와 pose를 가집니다. TabletopKit은 이 ID를 기준으로 각 주사위의 상태와 인터랙션 결과를 독립적으로 추적합니다.

            주사위가 보이지 않는다면 `dice/D6` 경로와 각 `Die`가 `setup.add(equipment:)`로 등록되었는지 확인합니다.
        }
        @Steps {
            @Step {
                앱을 다시 실행합니다. 정상이라면 테이블 중앙을 기준으로 D6 다섯 개가 겹치지 않고 나란히 보입니다. 지금은 주사위를 잡아 던질 수 없어도 정상입니다.
                @Image(
                    source: "3_Section 3_Step 1.png",
                    alt: "visionOS Simulator의 원형 테이블 위에 D6 주사위 다섯 개가 나란히 놓인 모습입니다."
                )
            }
        }
    }

    @Assessments {
        @MultipleChoice {
            `EntityEquipment`의 `entity`는 무엇을 담당하나요?
            @Choice(isCorrect: true) {
                장비에 대응해 화면에 표시할 RealityKit object를 제공합니다.
                @Justification(reaction: "정답입니다.") {
                    TabletopKit의 논리적 장비 상태와 실제로 보이는 RealityKit 엔티티를 연결합니다.
                }
            }
            @Choice(isCorrect: false) {
                장비의 현재 face 값과 pose만 저장하고 시각적인 모델은 포함하지 않습니다.
                @Justification(reaction: "아닙니다.") {
                    face 값과 pose는 상태가 담당하고 `entity`는 시각적 object입니다.
                }
            }
            @Choice(isCorrect: false) {
                같은 종류의 주사위가 공유할 `EquipmentIdentifier`를 생성합니다.
                @Justification(reaction: "아닙니다.") {
                    각 장비의 `id`는 별도 속성이며 서로 고유해야 합니다.
                }
            }
        }
        @MultipleChoice {
            D6 모델이 이미 cube 모양이어도 `TossableRepresentation.cube`를 지정하는 이유는 무엇인가요?
            @Choice(isCorrect: false) {
                RealityKit mesh를 cube 형태로 다시 모델링하고 텍스처 UV를 재생성하기 위해서입니다.
                @Justification(reaction: "아닙니다.") {
                    시각적 mesh와 텍스처를 변경하는 API가 아닙니다.
                }
            }
            @Choice(isCorrect: true) {
                TabletopKit의 던지기 시뮬레이션이 사용할 논리적인 형태와 face 구조를 알려 주기 위해서입니다.
                @Justification(reaction: "맞아요.") {
                    시각적 메시와 던지기 형태은 역할이 분리되어 있습니다.
                }
            }
            @Choice(isCorrect: false) {
                `EntityEquipment`가 `ModelEntity`를 로드할 수 있도록 bundle 경로를 지정하기 위해서입니다.
                @Justification(reaction: "아닙니다.") {
                    에셋 경로는 `ModelEntity.load`의 `named:`와 bundle에서 지정합니다.
                }
            }
        }
        @MultipleChoice {
            다섯 주사위가 같은 `EquipmentIdentifier`를 사용하면 어떤 문제가 생기나요?
            @Choice(isCorrect: false) {
                다섯 모델이 자동으로 하나의 material을 공유하게 됩니다.
                @Justification(reaction: "아닙니다.") {
                    material 공유 여부는 장비 ID와 관계없습니다.
                }
            }
            @Choice(isCorrect: false) {
                initial pose를 다르게 지정해도 모든 주사위의 위치가 항상 같아집니다.
                @Justification(reaction: "아닙니다.") {
                    핵심 문제는 pose 자체보다 TabletopKit이 장비의 identity를 구분하지 못하는 데 있습니다.
                }
            }
            @Choice(isCorrect: true) {
                TabletopKit이 인터랙션과 스냅샷에서 각 장비를 독립적으로 식별할 수 없습니다.
                @Justification(reaction: "정답입니다.") {
                    장비 검색과 상태 갱신이 ID를 기준으로 이루어지므로 각 주사위에는 고유 ID가 필요합니다.
                }
            }
        }
    }
}
