@Tutorial(time: 25) {
    @Intro(title: "다섯 주사위를 함께 던지기") {
        이번 단원에서는 `TabletopInteraction`을 연결합니다. 먼저 사용자가 집은 한 주사위만 던진 뒤, 나머지 네 개를 같은 인터랙션에 묶어 Yacht처럼 다섯 개가 함께 굴러가도록 확장합니다.
    }

    @Section(title: "SwiftUI 뷰와 TabletopInteraction 연결하기") {
        @ContentAndMedia {
            2단원에서 `.tabletopGame` 수식어로 RealityView와 `TabletopGame`을 연결했습니다. 이번에는 같은 수식어에 인터랙션 closure를 추가해 사용자의 공간 제스처를 `DiceInteraction`으로 전달합니다.

            인터랙션은 **장비를 집음 → 인터랙션 생성 → 움직이는 동안 pose 갱신 → 손을 놓음 → `interaction.toss(...)` 요청 → 최종 결과 계산 → 스냅샷 갱신** 순서로 진행됩니다. `DiceInteraction`은 이 흐름에서 제스처와 TabletopKit 던지기 사이를 이어 줍니다.
        }
        @Steps {
            @Step {
                Xcode에서 새 Swift 파일 `DiceInteraction.swift`를 만들고 `TabletopInteraction` 구현을 작성합니다. 사용자가 조작한 주사위를 찾은 뒤 제스처가 끝나면 `interaction.toss`를 요청하도록 인터랙션의 기본 흐름을 구현합니다.
                @Code(name: "DiceInteraction.swift", file: 04-01-DiceInteraction-One.swift, reset: true)
            }
            @Step {
                `ContentView.swift`를 열어 2단원에서 추가한 `.tabletopGame(game.tabletopGame, parent: game.root)` 호출을 `DiceInteraction` 생성 클로저가 있는 버전으로 교체합니다. 이제 사용자가 장비를 조작하면 `DiceInteraction`이 생성되어 공간 제스처를 TabletopKit 인터랙션으로 처리합니다.
                @Code(name: "ContentView.swift", file: 04-02-ContentView-TabletopInteraction.swift, previousFile: 02-07-ContentView.swift)
            }
        }
    }

    @Section(title: "한 개의 제스처로 다섯 개 던지기") {
        @ContentAndMedia {
            사용자가 직접 집은 주사위를 `controlledDie`, 함께 움직일 나머지를 `extraDiceToToss`로 나눕니다. 인터랙션이 다섯 개로 확장되면 한 파일에 lifecycle과 결과 반영이 모두 모이기 쉬우므로, **상태/초기화**, **제스처 update**, **던지기 outcome 반영**을 각각 나눠 읽습니다.
        }
        @Steps {
            @Step {
                `DiceInteraction.swift`를 다시 열어 한 주사위만 처리하던 구현을 **다섯 주사위의 상태와 초기화를 관리하는 구현으로 교체**합니다. 제스처와 던지기 처리 메서드는 다음 두 Swift 파일로 옮깁니다. 사용자가 잡은 주사위를 기준으로 함께 움직일 나머지 주사위를 찾습니다.
                @Code(name: "DiceInteraction.swift", file: 04-03-DiceInteraction-Five.swift, previousFile: 04-01-DiceInteraction-One.swift)
            }
            @Step {
                Xcode에서 새 Swift 파일 `DiceInteraction+Update.swift`를 만듭니다. 이 파일의 `extension DiceInteraction` 안에 제스처 phase별 위치 갱신과 던지기 요청 메서드를 작성합니다.
                @Code(name: "DiceInteraction+Update.swift", file: 04-04-DiceInteraction+Update-Five.swift, reset: true)
            }
            @Step {
                Xcode에서 새 Swift 파일 `DiceInteraction+TossOutcome.swift`를 만듭니다. 던지기 시뮬레이션에서 얻은 최종 회전·위치를 장비 상태에 반영하는 메서드를 이 extension에 작성합니다.
                @Code(name: "DiceInteraction+TossOutcome.swift", file: 04-05-DiceInteraction+TossOutcome.swift, reset: true)
            }
        }
    }


    @Section(title: "실행해서 확인하기") {
        @ContentAndMedia {
            다섯 주사위 중 하나를 집어 움직인 뒤 놓으면 다섯 개가 함께 던져져야 합니다. 이 시점에는 아직 화면에 1~6 결과를 표시하지 않습니다.

            이 시점부터 주사위의 pose는 고정된 초기값만 사용하는 것이 아니라 `TabletopInteraction`에 의해 갱신됩니다. 사용자가 직접 잡은 주사위가 인터랙션의 기준이 되고, 나머지 네 개는 그 기준에 묶여 함께 이동한 뒤 각자의 던지기 결과를 갖습니다.

            던지기가 끝나면 TabletopKit은 각 주사위의 최종 face를 스냅샷에 남깁니다. 이 값은 아직 Yacht의 1~6 숫자가 아니므로, 다음 단계에서는 면 매핑을 통해 게임에서 사용할 결과로 해석합니다.

            주사위는 보이지만 잡히지 않는다면 로컬 플레이어 좌석가 claim되어 있는지와 `.tabletopGame`의 인터랙션 closure가 현재 `ContentView`에 연결되어 있는지 확인합니다.
        }
        @Steps {
            @Step {
                앱에서 주사위 하나를 집어 움직인 뒤 놓습니다. 정상이라면 잡은 주사위를 기준으로 다섯 개가 함께 움직이고, 놓으면 각각 다른 자세로 굴러갑니다. 눈의 숫자 UI는 아직 표시되지 않습니다.
                @Image(
                    source: "4_Section 3_Step 1.png",
                    alt: "다섯 D6 주사위를 던진 뒤 각각 다른 위치와 방향으로 놓인 모습입니다."
                )
            }
        }
    }

    @Assessments {
        @MultipleChoice {
            `controlledDie`는 어떤 주사위인가요?
            @Choice(isCorrect: false) {
                `game.dice` 배열에서 항상 첫 번째에 있는 주사위입니다.
                @Justification(reaction: "아닙니다.") {
                    배열 순서가 아니라 사용자가 인터랙션을 시작한 장비 ID로 결정됩니다.
                }
            }
            @Choice(isCorrect: true) {
                사용자가 직접 집어서 현재 인터랙션을 시작한 주사위입니다.
                @Justification(reaction: "정답입니다.") {
                    `initialInteractionValue.controlledEquipmentID`로 해당 주사위를 찾습니다.
                }
            }
            @Choice(isCorrect: false) {
                한 번의 던지기에 포함되는 모든 주사위를 나타내는 가상의 parent 장비입니다.
                @Justification(reaction: "아닙니다.") {
                    `controlledDie`는 실제 `Die` 하나이며 나머지 주사위를 잠시 그 아래에 grouping합니다.
                }
            }
        }
        @MultipleChoice {
            제스처가 끝난 뒤 `interaction.toss`를 호출하는 이유는 무엇인가요?
            @Choice(isCorrect: true) {
                사용자가 놓은 시점부터 TabletopKit에 던지기 시뮬레이션과 최종 결과 계산을 요청하기 위해서입니다.
                @Justification(reaction: "맞아요.") {
                    제스처 종료를 실제 던지기 시작 시점으로 사용합니다.
                }
            }
            @Choice(isCorrect: false) {
                SwiftUI의 제스처 animation을 종료하고 뷰 hierarchy를 다시 그리기 위해서입니다.
                @Justification(reaction: "아닙니다.") {
                    `interaction.toss`는 SwiftUI animation API가 아니라 TabletopKit 인터랙션 API입니다.
                }
            }
            @Choice(isCorrect: false) {
                사용자가 조작한 주사위의 `EquipmentIdentifier`를 새로운 굴리기용 ID로 교체하기 위해서입니다.
                @Justification(reaction: "아닙니다.") {
                    던지기 전후에도 주사위의 identity는 유지됩니다.
                }
            }
        }
        @MultipleChoice {
            나머지 주사위를 던지기 후 다시 테이블의 child로 옮기는 이유는 무엇인가요?
            @Choice(isCorrect: false) {
                다음 던지기 전에 주사위마다 새로운 face map을 다시 적용하기 위해서입니다.
                @Justification(reaction: "아닙니다.") {
                    face map은 주사위가 유지하고 있는 규칙이며 reparenting과 무관합니다.
                }
            }
            @Choice(isCorrect: false) {
                던지기가 끝날 때마다 장비 ID를 테이블 ID의 하위 값으로 바꾸기 위해서입니다.
                @Justification(reaction: "아닙니다.") {
                    ID를 바꾸는 것이 아니라 parent coordinate system을 복구합니다.
                }
            }
            @Choice(isCorrect: true) {
                인터랙션 동안 사용자가 조작한 주사위 아래에 임시로 묶었던 좌표계를 다시 tabletop 기준으로 복구하기 위해서입니다.
                @Justification(reaction: "정답입니다.") {
                    grouping은 함께 움직이기 위한 임시 상태이고, 던지기 결과는 다시 테이블 기준의 장비로 유지합니다.
                }
            }
        }
    }
}
