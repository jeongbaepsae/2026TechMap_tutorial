@Tutorial(time: 25) {
    @Intro(title: "Yacht 점수 계산하기") {
        이 단원은 TabletopKit이 아니라 **순수 Swift 게임 규칙**에 집중합니다. 현재 다섯 dice 결과를 입력하면 각 Yacht category에서 몇 점인지 계산하도록 만듭니다.
    }

    @Section(title: "점수 category 정의하기") {
        @ContentAndMedia {
            화면 문자열을 직접 조건문에 사용하지 않고 `YachtCategory` enum으로 category를 표현합니다. Numbers와 combination section도 여기서 구분합니다.
        }
        @Steps {
            @Step {
                `YachtCategory.swift` 파일을 새로 만듭니다. 12개 category, 표시 이름, Numbers의 target face를 정의합니다.
                @Code(name: "YachtCategory.swift", file: 07-01-YachtCategory.swift, reset: true)
            }
        }
    }

    @Section(title: "하나의 계산기에서 모든 category 처리하기") {
        @ContentAndMedia {
            점수 계산기는 RealityKit이나 TabletopKit state를 직접 읽지 않습니다. `[Int]` 다섯 개만 입력받기 때문에 테스트와 재사용이 쉬워집니다.
        }
        @Steps {
            @Step {
                `YachtScoreCalculator.swift` 파일을 새로 만듭니다. 먼저 Numbers와 Choice만 처리하는 최소한의 계산기를 구현합니다.
                @Code(name: "YachtScoreCalculator.swift", file: 07-02-YachtScoreCalculator-Basic.swift, reset: true)
            }
            @Step {
                먼저 frequency map을 추가해 Four of a Kind와 Full House를 처리합니다. 두 규칙이 **같은 빈도 데이터**를 재사용하는 구조를 확인하세요.
                @Code(name: "YachtScoreCalculator.swift", file: 07-03-YachtScoreCalculator-Groups.swift, previousFile: 07-02-YachtScoreCalculator-Basic.swift)
            }
            @Step {
                `Set`을 이용한 Straight와 Yacht 규칙, 모든 category preview를 만드는 `scores(for:)`를 추가합니다.
                @Code(name: "YachtScoreCalculator.swift", file: 07-04-YachtScoreCalculator-All.swift, previousFile: 07-03-YachtScoreCalculator-Groups.swift)
            }
            @Step {
                이제 `YachtGame.swift`로 이동합니다. calculator를 연결하고 현재 roll에 대한 모든 category preview를 계산합니다.
                @Code(name: "YachtGame.swift", file: 07-05-YachtGame-Previews.swift, previousFile: 06-02-YachtGame-Hold.swift)
            }
        }
    }

    @Section(title: "확인하기") {
        @ContentAndMedia {
            예를 들어 `[6, 6, 6, 6, 2]`라면 Sixes는 24점, Four of a Kind는 26점처럼 category마다 다른 preview를 얻을 수 있습니다.

            `YachtScoreCalculator`는 TabletopKit이나 RealityKit 타입에 의존하지 않고 `[Int]`만 받습니다. 덕분에 3D interaction에서 얻은 결과를 순수한 게임 데이터로 바꾼 뒤, 각 category의 예상 점수를 독립적으로 계산할 수 있습니다.

            현재 계산된 값은 dice 결과가 바뀔 때마다 달라지는 preview입니다. Yacht에서는 한 category를 선택하는 순간 그 값을 확정해야 하므로, 다음 단원에서는 별도의 score sheet 상태를 추가합니다.
        }
        @Steps {
            @Step {
                `[6, 6, 6, 6, 2]`를 예로 들어 `YachtScoreCalculator`가 Sixes와 Four of a Kind를 각각 어떤 값으로 계산하는지 코드 흐름을 따라 확인합니다.
            }
        }
    }

    @Assessments {
        @MultipleChoice {
            점수 계산기를 TabletopKit 타입과 분리한 가장 큰 장점은 무엇인가요?
            @Choice(isCorrect: false) {
                점수 계산 코드를 분리하면 RealityKit의 rendering frame rate가 자동으로 높아집니다.
                @Justification(reaction: "아닙니다.") {
                    렌더링 성능 향상이 이 분리의 직접 목적은 아닙니다.
                }
            }
            @Choice(isCorrect: true) {
                `[Int]` 형태의 dice 결과만으로 게임 규칙을 독립적으로 테스트하고 재사용할 수 있습니다.
                @Justification(reaction: "정답입니다.") {
                    3D interaction이나 TabletopKit session 없이도 scoring rule을 검증할 수 있습니다.
                }
            }
            @Choice(isCorrect: false) {
                `YachtScoreCalculator`를 별도 타입으로 만들어야만 Swift에서 dictionary를 반환할 수 있습니다.
                @Justification(reaction: "아닙니다.") {
                    Swift 타입 시스템의 제한이 아니라 책임을 분리하기 위한 설계입니다.
                }
            }
        }
        @MultipleChoice {
            Full House 판단에 frequency map이 유용한 이유는 무엇인가요?
            @Choice(isCorrect: false) {
                각 die의 3D 위치를 정렬해 서로 가까운 dice를 같은 숫자로 판단할 수 있기 때문입니다.
                @Justification(reaction: "아닙니다.") {
                    점수 계산에서는 공간상의 위치를 사용하지 않습니다.
                }
            }
            @Choice(isCorrect: false) {
                `FaceMap`을 적용하지 않고도 cube face의 raw value를 바로 점수로 사용할 수 있기 때문입니다.
                @Justification(reaction: "아닙니다.") {
                    frequency map은 이미 숫자로 변환된 결과에서 각 값의 등장 횟수를 세는 구조입니다.
                }
            }
            @Choice(isCorrect: true) {
                각 눈이 몇 번 나왔는지를 세어 `[2, 3]` 같은 출현 빈도 패턴을 직접 비교할 수 있기 때문입니다.
                @Justification(reaction: "맞아요.") {
                    Full House처럼 값 자체보다 같은 값의 개수가 중요한 규칙에 적합합니다.
                }
            }
        }
        @MultipleChoice {
            현재 구현에서 `yachtScorePreviews`가 빈 dictionary를 반환하는 직접 조건은 무엇인가요?
            @Choice(isCorrect: true) {
                `hasRolled`가 false여서 아직 다섯 dice의 유효한 결과가 준비되지 않은 경우입니다.
                @Justification(reaction: "정답입니다.") {
                    preview score는 현재 roll 결과가 있을 때만 계산합니다.
                }
            }
            @Choice(isCorrect: false) {
                `rollCount`가 최대값인 3에 도달한 경우입니다.
                @Justification(reaction: "아닙니다.") {
                    세 번째 roll 이후에도 현재 결과가 있다면 score preview는 표시할 수 있습니다.
                }
            }
            @Choice(isCorrect: false) {
                다섯 dice가 모두 Hold된 경우입니다.
                @Justification(reaction: "아닙니다.") {
                    모두 Hold되었더라도 이미 읽은 dice 결과가 있다면 score preview 자체는 계산할 수 있습니다.
                }
            }
        }
    }
}
