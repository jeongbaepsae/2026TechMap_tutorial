@Tutorial(time: 35) {
    @Intro(title: "점수표에 category 기록하기") {
        현재 roll의 preview를 점수표에 표시하고, 사용자가 하나의 category를 선택하면 그 점수를 고정합니다. 기록이 끝나면 Hold와 roll count를 초기화해 다음 턴을 시작합니다.
    }

    @Section(title: "기록할 데이터 구조 만들기") {
        @ContentAndMedia {
            preview는 언제든 다시 계산할 수 있지만 선택된 category의 점수는 게임이 끝날 때까지 유지해야 합니다. 따라서 별도의 score sheet model을 둡니다.

            `YachtScoreEntry`에는 category와 score뿐 아니라 그 점수를 확정했을 때의 dice 결과도 저장합니다. 이 dice 배열은 점수를 다시 계산하기 위한 값이 아니라, 점수표에서 **어떤 주사위 조합으로 기록했는지** 보여 주기 위한 기록입니다.
        }
        @Steps {
            @Step {
                `YachtScoreEntry.swift` 파일을 새로 만듭니다.
                @Code(name: "YachtScoreEntry.swift", file: 08-01-YachtScoreEntry.swift, reset: true)
            }
            @Step {
                `YachtScoreSheet.swift`에 entry dictionary와 `record`를 추가합니다.
                @Code(name: "YachtScoreSheet.swift", file: 08-02-YachtScoreSheet-Basic.swift, reset: true)
            }
            @Step {
                `YachtGame.swift`에는 turn과 별도로 유지될 `scoreSheet` 상태를 추가합니다.
                @Code(name: "YachtGame.swift", file: 08-03-YachtGame-ScoreSheet.swift, previousFile: 07-06-YachtGame-Scoring.swift)
            }
            @Step {
                category를 확정하고 다음 turn을 초기화하는 동작은 `YachtGame+Scoring.swift`에 추가합니다.
                @Code(name: "YachtGame+Scoring.swift", file: 08-04-YachtGame+Scoring-Record.swift, previousFile: 07-07-YachtGame+Scoring-Preview.swift)
            }
        }
    }


    @Section(title: "점수표 UI 연결하기") {
        @ContentAndMedia {
            이미 기록된 row와 아직 선택 가능한 row의 모양을 분리하면 score sheet가 읽기 쉬워집니다. UI는 아래처럼 작은 component에서 전체 score sheet로 조립합니다.

            `YachtScoreSheetView → YachtScoreSectionView → YachtScoreRow → YachtRecordedScoreRow / DiceFaceSymbolsView`

            데이터 흐름은 `YachtGame`의 preview와 score sheet에서 시작하고, category 선택은 다시 `commitScore(...)`로 돌아갑니다.
        }
        @Steps {
            @Step {
                `DieFaceSymbol.swift`에서 기록된 dice를 SF Symbols로 표시합니다.
                @Code(name: "DieFaceSymbol.swift", file: 08-05-DieFaceSymbol.swift, reset: true)
            }
            @Step {
                확정된 category의 표시를 `YachtRecordedScoreRow.swift`로 분리합니다.
                @Code(name: "YachtRecordedScoreRow.swift", file: 08-06-YachtRecordedScoreRow.swift, reset: true)
            }
            @Step {
                `YachtScoreRow.swift`는 기록 여부에 따라 recorded row 또는 선택 가능한 preview row를 보여 줍니다.
                @Code(name: "YachtScoreRow.swift", file: 08-07-YachtScoreRow.swift, reset: true)
            }
            @Step {
                `YachtScoreSectionView.swift`에서 여러 row를 Numbers 또는 Combinations 묶음으로 보여 줍니다.
                @Code(name: "YachtScoreSectionView.swift", file: 08-08-YachtScoreSectionView.swift, reset: true)
            }
            @Step {
                `YachtScoreSheetView.swift`에서 두 section과 total을 조립합니다.
                @Code(name: "YachtScoreSheetView.swift", file: 08-09-YachtScoreSheetView-Basic.swift, reset: true)
            }
            @Step {
                `ContentView.swift`의 뒤쪽 ornament에 score sheet를 배치하고 category tap을 `commitScore`에 연결합니다.
                @Code(name: "ContentView.swift", file: 08-10-ContentView-ScoreSheet.swift, previousFile: 06-06-ContentView-Hold.swift)
            }
        }
    }


    @Section(title: "실행해서 확인하기") {
        @ContentAndMedia {
            한 번 이상 roll하면 아직 비어 있는 category에 예상 점수가 나타납니다. 하나를 선택하면 실제 기록으로 바뀌고, dice 결과와 roll count가 다음 턴 상태로 초기화되어야 합니다.

            예상 점수와 기록된 점수는 생명주기가 다릅니다. preview는 dice가 바뀔 때마다 다시 계산되지만 `YachtScoreEntry`는 category가 확정된 뒤 게임이 끝날 때까지 유지됩니다. `YachtScoreSheet`가 이 영구 상태를 소유합니다.

            각 category의 기록 여부가 score sheet에 남기 때문에 같은 데이터에서 Numbers subtotal과 bonus를 계산하고, 모든 category가 채워졌는지도 판단할 수 있습니다.

            score sheet는 UI component가 많아지는 단원이므로, 코드가 길게 느껴지면 `Entry/Sheet = 데이터`, `Row/Section/SheetView = 표시`, `YachtGame = 두 영역을 연결하는 게임 상태`로 역할을 나눠서 확인합니다.
        }
        @Steps {
            @Step {
                앱에서 한 번 이상 roll한 뒤 category 하나를 선택해 preview가 기록 점수로 바뀌고 다음 turn이 시작되는지 확인합니다.
                @Image(
                    source: "8_Section 3_Step 1.png",
                    alt: "Sixes category에 dice 아이콘과 18점이 기록되어 Total Score가 18이 되었고, Dice 패널은 Roll 0 / 3으로 초기화되어 있습니다."
                )
            }
        }
    }

    @Assessments {
        @MultipleChoice {
            preview score와 recorded score를 분리하는 이유는 무엇인가요?
            @Choice(isCorrect: false) {
                `TabletopGame` snapshot은 한 번 읽으면 다시 사용할 수 없기 때문에 두 개의 score model이 필요합니다.
                @Justification(reaction: "아닙니다.") {
                    snapshot의 제약 때문이 아니라 두 데이터의 생명주기가 다르기 때문입니다.
                }
            }
            @Choice(isCorrect: false) {
                SwiftUI에서는 아직 기록하지 않은 값과 기록된 값을 같은 View에서 표시할 수 없기 때문입니다.
                @Justification(reaction: "아닙니다.") {
                    UI 기술적 제한이 아니라 game state의 의미를 분리하는 설계입니다.
                }
            }
            @Choice(isCorrect: true) {
                preview는 현재 roll에 따라 계속 바뀌지만, 한 번 기록한 category의 score는 이후 turn에도 유지되어야 하기 때문입니다.
                @Justification(reaction: "정답입니다.") {
                    임시 계산 결과와 확정된 게임 기록을 서로 다른 상태로 관리합니다.
                }
            }
        }
        @MultipleChoice {
            같은 category를 두 번 기록하는 것을 최종적으로 막아야 하는 곳은 어디인가요?
            @Choice(isCorrect: true) {
                `YachtScoreSheet.record`처럼 score sheet model의 기록 로직입니다.
                @Justification(reaction: "맞아요.") {
                    UI가 아닌 model 계층에서도 중복 기록 규칙을 보장해야 다른 호출 경로에서도 상태가 안전합니다.
                }
            }
            @Choice(isCorrect: false) {
                `YachtScoreRow`의 `.disabled` modifier만으로 충분합니다.
                @Justification(reaction: "아닙니다.") {
                    UI 차단은 보조 수단이고, 핵심 게임 규칙은 model에서도 검증하는 편이 안전합니다.
                }
            }
            @Choice(isCorrect: false) {
                `TabletopGame.withCurrentSnapshot`이 이미 기록된 category를 자동으로 걸러 줍니다.
                @Justification(reaction: "아닙니다.") {
                    TabletopKit snapshot은 dice state를 제공하며 Yacht score sheet의 category 기록 규칙을 알지 못합니다.
                }
            }
        }
        @MultipleChoice {
            점수를 기록한 직후 turn state를 초기화하는 이유는 무엇인가요?
            @Choice(isCorrect: false) {
                score를 기록할 때마다 새로운 `TabletopGame` instance를 만들어야 하기 때문입니다.
                @Justification(reaction: "아닙니다.") {
                    같은 TabletopGame을 유지한 채 Yacht의 다음 turn으로 넘어갑니다.
                }
            }
            @Choice(isCorrect: true) {
                category 선택으로 현재 turn이 끝났으므로 roll count와 Hold를 초기화해 다음 turn을 새 상태로 시작하기 위해서입니다.
                @Justification(reaction: "정답입니다.") {
                    기록된 score는 유지하고 turn에만 속한 임시 상태를 정리합니다.
                }
            }
            @Choice(isCorrect: false) {
                기록된 score를 preview dictionary로 다시 되돌리기 위해서입니다.
                @Justification(reaction: "아닙니다.") {
                    recorded score는 score sheet에 유지되고 preview는 다음 roll 결과에서 다시 계산합니다.
                }
            }
        }
    }
}
