@Tutorial(time: 35) {
    @Intro(title: "점수표에 category 기록하기") {
        현재 굴리기의 미리보기를 점수표에 표시하고, 사용자가 하나의 category를 선택하면 그 점수를 고정합니다. 기록이 끝나면 Hold와 굴리기 count를 초기화해 다음 턴을 시작합니다.
    }

    @Section(title: "기록할 데이터 구조 만들기") {
        @ContentAndMedia {
            미리보기는 언제든 다시 계산할 수 있지만 선택된 category의 점수는 게임이 끝날 때까지 유지해야 합니다. 따라서 별도의 점수표 모델을 둡니다.

            `YachtScoreEntry`에는 category와 점수뿐 아니라 그 점수를 확정했을 때의 주사위 결과도 저장합니다. 이 주사위 배열은 점수를 다시 계산하기 위한 값이 아니라, 점수표에서 **어떤 주사위 조합으로 기록했는지** 보여 주기 위한 기록입니다.
        }
        @Steps {
            @Step {
                Xcode에서 새 Swift 파일 `YachtScoreEntry.swift`를 만들고 확정한 점수·카테고리·주사위 눈값을 저장할 타입을 선언합니다.
                @Code(name: "YachtScoreEntry.swift", file: 08-01-YachtScoreEntry.swift, reset: true)
            }
            @Step {
                Xcode에서 새 Swift 파일 `YachtScoreSheet.swift`를 만들고 카테고리별 기록을 저장할 dictionary와 `record` 메서드를 정의합니다.
                @Code(name: "YachtScoreSheet.swift", file: 08-02-YachtScoreSheet-Basic.swift, reset: true)
            }
            @Step {
                `YachtGame.swift`를 열어 턴 상태와 별도로 유지할 `scoreSheet` 저장 프로퍼티를 추가합니다.
                @Code(name: "YachtGame.swift", file: 08-03-YachtGame-ScoreSheet.swift, previousFile: 07-06-YachtGame-Scoring.swift)
            }
            @Step {
                `YachtGame+Scoring.swift`를 열어 선택한 카테고리를 확정하고 다음 턴 상태를 초기화하는 `commitScore` 로직을 추가합니다.
                @Code(name: "YachtGame+Scoring.swift", file: 08-04-YachtGame+Scoring-Record.swift, previousFile: 07-07-YachtGame+Scoring-Preview.swift)
            }
        }
    }


    @Section(title: "점수표 UI 연결하기") {
        @ContentAndMedia {
            이미 기록된 row와 아직 선택 가능한 row의 모양을 분리하면 점수표가 읽기 쉬워집니다. UI는 아래처럼 작은 component에서 전체 점수표로 조립합니다.

            `YachtScoreSheetView → YachtScoreSectionView → YachtScoreRow → YachtRecordedScoreRow / DiceFaceSymbolsView`

            데이터 흐름은 `YachtGame`의 미리보기와 점수표에서 시작하고, category 선택은 다시 `commitScore(...)`로 돌아갑니다.
        }
        @Steps {
            @Step {
                Xcode에서 새 Swift 파일 `DieFaceSymbol.swift`를 만들고 기록된 주사위 눈값을 SF Symbols로 보여주는 뷰를 정의합니다.
                @Code(name: "DieFaceSymbol.swift", file: 08-05-DieFaceSymbol.swift, reset: true)
            }
            @Step {
                Xcode에서 새 Swift 파일 `YachtRecordedScoreRow.swift`를 만들고 이미 기록한 카테고리의 점수 행을 구현합니다.
                @Code(name: "YachtRecordedScoreRow.swift", file: 08-06-YachtRecordedScoreRow.swift, reset: true)
            }
            @Step {
                Xcode에서 새 Swift 파일 `YachtScoreRow.swift`를 만들고 기록 여부에 따라 확정 행과 선택 가능한 예상 점수 행을 전환하는 뷰를 정의합니다.
                @Code(name: "YachtScoreRow.swift", file: 08-07-YachtScoreRow.swift, reset: true)
            }
            @Step {
                Xcode에서 새 Swift 파일 `YachtScoreSectionView.swift`를 만들고 여러 점수 행을 Numbers와 Combinations 섹션으로 묶어 표시합니다.
                @Code(name: "YachtScoreSectionView.swift", file: 08-08-YachtScoreSectionView.swift, reset: true)
            }
            @Step {
                Xcode에서 새 Swift 파일 `YachtScoreSheetView.swift`를 만들고 두 점수 섹션과 총점을 조합합니다.
                @Code(name: "YachtScoreSheetView.swift", file: 08-09-YachtScoreSheetView-Basic.swift, reset: true)
            }
            @Step {
                `ContentView.swift`를 열어 기존 앞쪽 결과 ornament는 유지하고, **뒤쪽 점수표 ornament와 카테고리 선택 시 `commitScore` 호출을 추가**합니다.
                @Code(name: "ContentView.swift", file: 08-10-ContentView-ScoreSheet.swift, previousFile: 06-06-ContentView-Hold.swift)
            }
        }
    }


    @Section(title: "실행해서 확인하기") {
        @ContentAndMedia {
            한 번 이상 굴리기하면 아직 비어 있는 category에 예상 점수가 나타납니다. 하나를 선택하면 실제 기록으로 바뀌고, 주사위 결과와 굴리기 count가 다음 턴 상태로 초기화되어야 합니다.

            예상 점수와 기록된 점수는 생명주기가 다릅니다. 미리보기는 주사위가 바뀔 때마다 다시 계산되지만 `YachtScoreEntry`는 category가 확정된 뒤 게임이 끝날 때까지 유지됩니다. `YachtScoreSheet`가 이 영구 상태를 소유합니다.

            각 category의 기록 여부가 점수표에 남기 때문에 같은 데이터에서 Numbers subtotal과 bonus를 계산하고, 모든 category가 채워졌는지도 판단할 수 있습니다.

            점수표는 UI component가 많아지는 단원이므로, 코드가 길게 느껴지면 `Entry/Sheet = 데이터`, `Row/Section/SheetView = 표시`, `YachtGame = 두 영역을 연결하는 게임 상태`로 역할을 나눠서 확인합니다.
        }
        @Steps {
            @Step {
                앱에서 주사위를 한 번 이상 굴리고 점수 카테고리 하나를 선택합니다. 정상이라면 예상 점수가 확정 점수로 바뀌고, 굴리기 횟수와 Hold가 다음 턴의 초기 상태로 돌아갑니다.
                @Image(
                    source: "8_Section 3_Step 1.png",
                    alt: "Sixes 카테고리에 18점이 기록되어 Total Score가 18이 되고, 주사위 결과 패널은 Roll 0 / 3으로 초기화된 화면입니다."
                )
            }
        }
    }

    @Assessments {
        @MultipleChoice {
            미리보기 점수와 recorded 점수를 분리하는 이유는 무엇인가요?
            @Choice(isCorrect: false) {
                `TabletopGame` 스냅샷은 한 번 읽으면 다시 사용할 수 없기 때문에 두 개의 점수 모델이 필요합니다.
                @Justification(reaction: "아닙니다.") {
                    스냅샷의 제약 때문이 아니라 두 데이터의 생명주기가 다르기 때문입니다.
                }
            }
            @Choice(isCorrect: false) {
                SwiftUI에서는 아직 기록하지 않은 값과 기록된 값을 같은 뷰에서 표시할 수 없기 때문입니다.
                @Justification(reaction: "아닙니다.") {
                    UI 기술적 제한이 아니라 게임 상태의 의미를 분리하는 설계입니다.
                }
            }
            @Choice(isCorrect: true) {
                미리보기는 현재 굴리기에 따라 계속 바뀌지만, 한 번 기록한 category의 점수는 이후 턴에도 유지되어야 하기 때문입니다.
                @Justification(reaction: "정답입니다.") {
                    임시 계산 결과와 확정된 게임 기록을 서로 다른 상태로 관리합니다.
                }
            }
        }
        @MultipleChoice {
            같은 category를 두 번 기록하는 것을 최종적으로 막아야 하는 곳은 어디인가요?
            @Choice(isCorrect: true) {
                `YachtScoreSheet.record`처럼 점수표 모델의 기록 로직입니다.
                @Justification(reaction: "맞아요.") {
                    UI가 아닌 모델 계층에서도 중복 기록 규칙을 보장해야 다른 호출 경로에서도 상태가 안전합니다.
                }
            }
            @Choice(isCorrect: false) {
                `YachtScoreRow`의 `.disabled` 수식어만으로 충분합니다.
                @Justification(reaction: "아닙니다.") {
                    UI 차단은 보조 수단이고, 핵심 게임 규칙은 모델에서도 검증하는 편이 안전합니다.
                }
            }
            @Choice(isCorrect: false) {
                `TabletopGame.withCurrentSnapshot`이 이미 기록된 category를 자동으로 걸러 줍니다.
                @Justification(reaction: "아닙니다.") {
                    TabletopKit 스냅샷은 주사위 상태를 제공하며 Yacht 점수표의 category 기록 규칙을 알지 못합니다.
                }
            }
        }
        @MultipleChoice {
            점수를 기록한 직후 턴 상태를 초기화하는 이유는 무엇인가요?
            @Choice(isCorrect: false) {
                점수를 기록할 때마다 새로운 `TabletopGame` instance를 만들어야 하기 때문입니다.
                @Justification(reaction: "아닙니다.") {
                    같은 TabletopGame을 유지한 채 Yacht의 다음 턴으로 넘어갑니다.
                }
            }
            @Choice(isCorrect: true) {
                category 선택으로 현재 턴이 끝났으므로 굴리기 count와 Hold를 초기화해 다음 턴을 새 상태로 시작하기 위해서입니다.
                @Justification(reaction: "정답입니다.") {
                    기록된 점수는 유지하고 턴에만 속한 임시 상태를 정리합니다.
                }
            }
            @Choice(isCorrect: false) {
                기록된 점수를 미리보기 dictionary로 다시 되돌리기 위해서입니다.
                @Justification(reaction: "아닙니다.") {
                    recorded 점수는 점수표에 유지되고 미리보기는 다음 굴리기 결과에서 다시 계산합니다.
                }
            }
        }
    }
}
