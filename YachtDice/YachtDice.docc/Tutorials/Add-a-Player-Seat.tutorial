@Tutorial(time: 15) {
    @Intro(title: "싱글플레이에서도 seat 추가하기") {
        `TableSeat`이 무엇을 나타내는지 확인하고 로컬 플레이어가 사용할 한 개의 좌석을 만듭니다.
    }

    @Section(title: "TableSeat의 상태 이해하기") {
        @ContentAndMedia {
            seat는 SwiftUI 좌석 UI가 아니라 TabletopKit 안에서 플레이어의 위치를 표현하는 논리적 객체입니다. `initialState`의 `Pose2D`는 table space의 x, z 위치와 회전을 가집니다.
        }

        @Steps {
            @Step {
                `PlayerSeat`이 `TableSeat`을 채택하고 `id`와 `initialState`를 선언합니다.

                @Code(name: "PlayerSeat.swift — protocol", file: 03-01-Seat-Protocol.swift)
            }

            @Step {
                전달받은 x/z 위치와 회전을 `TableSeatState`의 pose로 변환합니다.

                @Code(name: "PlayerSeat.swift — state", file: 03-02-Seat-State.swift)
            }
        }
    }

    @Section(title: "setup에 seat 등록하기") {
        @ContentAndMedia {
            seat를 정의했다고 자동으로 게임에 들어가는 것은 아닙니다. `TableSetup`에 직접 추가해야 현재 게임 구성이 됩니다.
        }

        @Steps {
            @Step {
                테이블 앞쪽을 나타내는 `(x: 0, z: 0.5)` 위치에 seat 하나를 생성합니다.

                @Code(name: "YachtGame.swift — create seat", file: 03-03-Create-Seat.swift)
            }

            @Step {
                `setup.add(seat:)`로 seat를 초기 구성에 넣습니다.

                @Code(name: "YachtGame.swift — add seat", file: 03-04-Add-Seat.swift)
            }

            @Step {
                `TabletopGame`을 만든 뒤 `claimAnySeat()`을 호출해 로컬 플레이어가 사용 가능한 seat를 차지하게 합니다.

                @Code(name: "YachtGame.swift — claim seat", file: 03-05-Claim-Seat.swift)
            }
        }
    }
}
