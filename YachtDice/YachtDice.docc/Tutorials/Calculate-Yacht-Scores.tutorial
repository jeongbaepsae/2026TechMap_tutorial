@Tutorial(time: 40) {
    @Intro(title: "Yacht 점수 규칙을 순수 Swift로 구현하기") {
        3D interaction과 점수 계산을 분리하고, 쉬운 Numbers 규칙부터 Combination 규칙까지 하나씩 추가합니다.
    }

    @Section(title: "카테고리를 데이터로 표현하기") {
        @Steps {
            @Step {
                12개의 점수 카테고리를 `YachtCategory` enum으로 정의합니다.

                @Code(name: "YachtCategory.swift — cases", file: 10-01-Category-Cases.swift)
            }

            @Step {
                Aces부터 Sixes까지가 어떤 눈을 세는지 `targetFace`로 연결합니다.

                @Code(name: "YachtCategory.swift — target face", file: 10-02-Category-Target.swift)
            }

            @Step {
                Numbers와 Combinations를 구분하는 `section`을 추가합니다. 나중에 점수표 UI와 보너스 계산이 같은 구분을 사용합니다.

                @Code(name: "YachtCategory.swift — section", file: 10-03-Category-Section.swift)
            }
        }
    }

    @Section(title: "Numbers와 Choice부터 계산하기") {
        @ContentAndMedia {
            계산기는 `[Int]`만 입력받고 `TabletopKit`이나 `RealityKit`을 import하지 않습니다. 이렇게 하면 점수 규칙을 3D 환경 없이도 테스트할 수 있습니다.
        }

        @Steps {
            @Step {
                다섯 개의 1~6 값인지 검사하는 입력 validation을 만듭니다.

                @Code(name: "YachtScoreCalculator.swift — validation", file: 10-04-Score-Validation.swift)
            }

            @Step {
                Numbers는 목표 face만 골라 합산합니다.

                @Code(name: "YachtScoreCalculator.swift — numbers", file: 10-05-Score-Numbers.swift)
            }

            @Step {
                Choice는 다섯 값을 모두 더합니다.

                @Code(name: "YachtScoreCalculator.swift — choice", file: 10-06-Score-Choice.swift)
            }
        }
    }

    @Section(title: "같은 눈의 개수를 이용하는 규칙 추가하기") {
        @Steps {
            @Step {
                `[Int: Int]` frequency map으로 각 눈이 몇 번 나왔는지 계산합니다.

                @Code(name: "YachtScoreCalculator.swift — frequency", file: 10-07-Score-Frequency.swift)
            }

            @Step {
                같은 눈이 네 개 이상이면 Five Dice 합계를 주는 Four of a Kind를 추가합니다.

                @Code(name: "YachtScoreCalculator.swift — four kind", file: 10-08-Score-FourKind.swift)
            }

            @Step {
                빈도 배열이 `[2, 3]`일 때만 인정하는 Full House를 추가합니다.

                @Code(name: "YachtScoreCalculator.swift — full house", file: 10-09-Score-FullHouse.swift)
            }
        }
    }

    @Section(title: "Straight와 Yacht 추가하기") {
        @Steps {
            @Step {
                중복을 제거한 `Set`이 4연속 패턴을 포함하는지 검사해 Small Straight 15점을 계산합니다.

                @Code(name: "YachtScoreCalculator.swift — small straight", file: 10-10-Score-SmallStraight.swift)
            }

            @Step {
                정확히 1–5 또는 2–6이면 Large Straight 30점을 반환합니다.

                @Code(name: "YachtScoreCalculator.swift — large straight", file: 10-11-Score-LargeStraight.swift)
            }

            @Step {
                `Set(dice).count == 1`이면 Yacht 50점을 반환합니다.

                @Code(name: "YachtScoreCalculator.swift — yacht", file: 10-12-Score-Yacht.swift)
            }
        }
    }

    @Section(title: "현재 주사위로 모든 예상 점수 만들기") {
        @Steps {
            @Step {
                `scores(for:)`가 12개 카테고리를 순회해 `[YachtCategory: Int]` dictionary를 만듭니다.

                @Code(name: "YachtScoreCalculator.swift — all scores", file: 10-13-All-Scores.swift)
            }

            @Step {
                `YachtGame.yachtScorePreviews`에서 현재 `lastRollResults`를 계산기에 전달합니다.

                @Code(name: "YachtGame.swift — previews", file: 10-14-Game-Previews.swift)
            }
        }
    }
}
