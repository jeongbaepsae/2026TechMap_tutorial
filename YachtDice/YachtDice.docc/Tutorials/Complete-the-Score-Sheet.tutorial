@Tutorial(time: 45) {
    @Intro(title: "점수 기록, 보너스, ornament로 게임 완성하기") {
        예상 점수를 실제 점수표에 기록하고 한 턴을 종료하는 흐름부터 Numbers 보너스와 게임 종료까지 작은 단계로 연결합니다.
    }

    @Section(title: "한 번 기록한 결과 보관하기") {
        @Steps {
            @Step {
                카테고리, 점수, 당시 다섯 주사위를 저장하는 `YachtScoreEntry`를 만듭니다.

                @Code(name: "YachtScoreEntry.swift", file: 11-01-Score-Entry.swift)
            }

            @Step {
                `YachtScoreSheet`에 `[YachtCategory: YachtScoreEntry]` dictionary를 둡니다.

                @Code(name: "YachtScoreSheet.swift — entries", file: 11-02-Sheet-Entries.swift)
            }

            @Step {
                이미 사용한 카테고리인지 확인하는 `contains`를 추가합니다.

                @Code(name: "YachtScoreSheet.swift — contains", file: 11-03-Sheet-Contains.swift)
            }

            @Step {
                한 카테고리를 한 번만 저장하는 `record`를 추가합니다.

                @Code(name: "YachtScoreSheet.swift — record", file: 11-04-Sheet-Record.swift)
            }
        }
    }

    @Section(title: "Numbers 합계와 보너스 계산하기") {
        @Steps {
            @Step {
                목표 63점과 보너스 35점을 `YachtBonusRule` 상수로 정의합니다.

                @Code(name: "YachtBonusRule.swift", file: 11-05-Bonus-Rule.swift)
            }

            @Step {
                기록된 `.upper` 카테고리만 더해 `numbersScore`를 계산합니다.

                @Code(name: "YachtScoreSheet.swift — numbers", file: 11-06-Sheet-Numbers.swift)
            }

            @Step {
                63점까지 남은 점수와 보너스 달성 여부를 computed property로 만듭니다.

                @Code(name: "YachtScoreSheet.swift — bonus state", file: 11-07-Sheet-BonusState.swift)
            }

            @Step {
                카테고리 합계에 보너스를 더해 최종 `totalScore`를 계산합니다.

                @Code(name: "YachtScoreSheet.swift — total", file: 11-08-Sheet-Total.swift)
            }
        }
    }

    @Section(title: "카테고리를 선택하면 한 턴 종료하기") {
        @Steps {
            @Step {
                `YachtGame`이 `YachtScoreSheet`을 상태로 소유하게 합니다.

                @Code(name: "YachtGame.swift — score sheet", file: 11-09-Game-ScoreSheet.swift)
            }

            @Step {
                `canCommitScore`로 현재 점수를 선택할 수 있는 상태인지 계산합니다.

                @Code(name: "YachtGame.swift — can commit", file: 11-10-Can-Commit.swift)
            }

            @Step {
                `commitScore(for:)`에서 현재 주사위의 점수를 계산해 sheet에 기록합니다.

                @Code(name: "YachtGame.swift — commit", file: 11-11-Commit-Score.swift)
            }

            @Step {
                기록 후 roll count, Hold, 현재 결과를 초기화해 다음 턴으로 넘어갑니다.

                @Code(name: "YachtGame.swift — reset turn", file: 11-12-Reset-Turn.swift)
            }
        }
    }

    @Section(title: "점수표의 한 행부터 만들기") {
        @Steps {
            @Step {
                기록된 행은 당시 주사위 SF Symbol과 확정 점수를 보여주는 `YachtScoreRow`로 만듭니다.

                @Code(name: "YachtScoreRow.swift — recorded", file: 11-13-Recorded-Row.swift)
            }

            @Step {
                아직 비어 있는 행은 예상 점수를 보여주고 탭하면 카테고리를 확정하도록 만듭니다.

                @Code(name: "YachtScoreRow.swift — available", file: 11-14-Available-Row.swift)
            }
        }
    }

    @Section(title: "Numbers와 Combinations로 행 묶기") {
        @Steps {
            @Step {
                여러 카테고리를 렌더링하는 `YachtScoreSectionView`를 만듭니다.

                @Code(name: "YachtScoreSectionView.swift", file: 11-15-Score-Section.swift)
            }

            @Step {
                `YachtScoreSheetView`에서 `.upper`는 Numbers, `.lower`는 Combinations 열에 배치합니다.

                @Code(name: "YachtScoreSheetView.swift — columns", file: 11-16-ScoreSheet-Columns.swift)
            }
        }
    }

    @Section(title: "보너스 진행 상태 간단히 보여주기") {
        @Steps {
            @Step {
                `NumbersBonusView`에 현재 `numbersScore / 63`과 progress를 표시합니다.

                @Code(name: "NumbersBonusView.swift — progress", file: 11-17-Bonus-Progress.swift)
            }

            @Step {
                미달성 중에는 남은 점수와 `+35 Bonus`, 달성 후에는 checkmark와 `+35`를 표시합니다.

                @Code(name: "NumbersBonusView.swift — status", file: 11-18-Bonus-Status.swift)
            }
        }
    }

    @Section(title: "게임판을 가리지 않게 ornament 배치하기") {
        @Steps {
            @Step {
                현재 다섯 주사위 결과는 volume 앞쪽의 ornament로 붙입니다.

                @Code(name: "ContentView.swift — dice ornament", file: 11-19-Dice-Ornament.swift)
            }

            @Step {
                점수표는 별도 window가 아니라 같은 volume의 뒤쪽 ornament로 붙여 게임과 함께 활성 상태를 유지합니다.

                @Code(name: "ContentView.swift — score ornament", file: 11-20-Score-Ornament.swift)
            }
        }
    }

    @Section(title: "12개 카테고리를 채우면 게임 끝내기") {
        @Steps {
            @Step {
                sheet의 entry 수가 전체 카테고리 수와 같으면 `isComplete`를 `true`로 계산합니다.

                @Code(name: "YachtScoreSheet.swift — complete", file: 11-21-Sheet-Complete.swift)
            }

            @Step {
                완료 상태에서는 Final Score와 Start New Game 버튼을 보여줍니다.

                @Code(name: "YachtScoreSheetView.swift — game complete", file: 11-22-Game-Complete.swift)
            }
        }
    }
}
