@Tutorial(time: 20) {
    @Intro(title: "volumetric visionOS 앱부터 시작하기") {
        TabletopKit 코드를 작성하기 전에 3D 게임이 들어갈 volume과 RealityKit root entity를 준비합니다.
    }

    @Section(title: "visionOS 앱의 공간 형태 정하기") {
        @ContentAndMedia {
            SwiftUI의 `WindowGroup`은 기본적으로 2D window를 만들 수 있습니다. Yacht Dice에서는 테이블의 깊이를 보여줘야 하므로 먼저 volumetric window로 바꿉니다.
        }

        @Steps {
            @Step {
                새 visionOS App 프로젝트의 앱 엔트리에 `WindowGroup`만 남겨 가장 작은 시작점을 만듭니다.

                @Code(name: "YachtDiceApp.swift — 시작", file: 01-01-App-Start.swift)
            }

            @Step {
                `.windowStyle(.volumetric)`을 추가해 window가 폭, 높이, 깊이를 가진 volume이 되게 합니다.

                @Code(name: "YachtDiceApp.swift — volumetric", file: 01-02-App-Volumetric.swift)
            }

            @Step {
                `.defaultSize`로 기본 크기를 1m × 1m × 1m로 정합니다. 이후 ornament의 위치도 이 volume의 경계를 기준으로 계산됩니다.

                @Code(name: "YachtDiceApp.swift — 1m volume", file: 01-03-App-Size.swift)
            }
        }
    }

    @Section(title: "TabletopKit보다 먼저 RealityKit root 만들기") {
        @ContentAndMedia {
            테이블과 주사위는 나중에 모두 하나의 RealityKit hierarchy 안에 들어갑니다. 아직 `TabletopGame`을 만들지 말고, 먼저 그 hierarchy의 최상위 `Entity`만 준비합니다.
        }

        @Steps {
            @Step {
                `YachtGame`을 만들고 빈 `root` entity 하나만 정의합니다.

                @Code(name: "YachtGame.swift — root", file: 01-04-YachtGame-Root.swift)
            }

            @Step {
                앱 엔트리에서 `YachtGame`을 `@State`로 소유하고 `ContentView`에 environment로 전달합니다. 이후 여러 UI가 같은 게임 상태를 보게 됩니다.

                @Code(name: "YachtDiceApp.swift — environment", file: 01-05-App-Environment.swift)
            }
        }
    }

    @Section(title: "RealityView에 root 표시하기") {
        @ContentAndMedia {
            `RealityView`는 SwiftUI 안에서 RealityKit entity를 렌더링하는 공간입니다. 지금은 root 안에 자식이 없기 때문에 화면에 아무 모델도 나타나지 않는 것이 정상입니다.
        }

        @Steps {
            @Step {
                `ContentView`에서 environment의 `YachtGame`을 읽습니다.

                @Code(name: "ContentView.swift — environment", file: 01-06-ContentView-Environment.swift)
            }

            @Step {
                `RealityView`의 make closure에서 `game.root`를 content에 추가합니다.

                @Code(name: "ContentView.swift — RealityView", file: 01-07-ContentView-RealityView.swift)
            }

            @Step {
                `GeometryReader3D`를 감싸 volume의 3D bounds를 읽을 준비를 합니다. 다음 튜토리얼에서 실제 테이블을 바닥에 맞출 때 사용합니다.

                @Code(name: "ContentView.swift — GeometryReader3D", file: 01-08-ContentView-Geometry.swift)
            }
        }
    }
}
