@Tutorial(time: 25) {
    @Intro(title: "EntityTabletop으로 게임판 정의하기") {
        RealityKit의 테이블 모델을 TabletopKit이 이해하는 논리적 tabletop으로 연결합니다.
    }

    @Section(title: "EntityTabletop의 세 가지 요구사항 확인하기") {
        @ContentAndMedia {
            RealityKit 모델을 그냥 `RealityView`에 넣는 것만으로는 TabletopKit이 그 모델을 게임판이라고 알지 못합니다. `EntityTabletop`은 `id`, `entity`, `shape`를 통해 두 계층을 연결합니다.
        }

        @Steps {
            @Step {
                테이블을 식별할 `EquipmentIdentifier.tableID`를 정의합니다. 장비와 테이블이 서로를 참조할 때 같은 ID를 사용합니다.

                @Code(name: "EquipmentIdentifier+Yacht.swift", file: 02-01-Table-ID.swift)
            }

            @Step {
                `RoundTabletop`이 `EntityTabletop`을 채택하고 `entity`, `id`, `shape` 프로퍼티를 선언합니다.

                @Code(name: "RoundTabletop.swift — protocol", file: 02-02-RoundTabletop-Protocol.swift)
            }
        }
    }

    @Section(title: "RealityKit 테이블 모델 연결하기") {
        @ContentAndMedia {
            `entity`는 사용자에게 실제로 보이는 모델입니다. 이 프로젝트에서는 Reality Composer Pro package의 `table/table` 모델을 불러옵니다.
        }

        @Steps {
            @Step {
                `Entity.load`로 테이블 모델을 불러와 `entity`에 저장합니다.

                @Code(name: "RoundTabletop.swift — entity", file: 02-03-RoundTabletop-Entity.swift)
            }

            @Step {
                `.round(entity:)`로 TabletopKit이 사용할 논리적인 원형 영역을 만듭니다. `shape`는 장비 배치와 interaction에서 사용되는 table space의 기준입니다.

                @Code(name: "RoundTabletop.swift — shape", file: 02-04-RoundTabletop-Shape.swift)
            }
        }
    }

    @Section(title: "TableSetup에서 TabletopGame 만들기") {
        @ContentAndMedia {
            `TableSetup`은 실행 중인 게임 그 자체가 아니라 **게임을 시작할 때의 배치 설명**입니다. setup을 완성한 뒤 `TabletopGame`을 생성합니다.
        }

        @Steps {
            @Step {
                `YachtGame`에 `TabletopGame` 프로퍼티를 추가합니다.

                @Code(name: "YachtGame.swift — TabletopGame property", file: 02-05-YachtGame-Property.swift)
            }

            @Step {
                `RoundTabletop`을 만들고 `TableSetup(tabletop:)`의 기준 테이블로 전달합니다.

                @Code(name: "YachtGame.swift — TableSetup", file: 02-06-YachtGame-Setup.swift)
            }

            @Step {
                완성된 setup을 `TabletopGame(tableSetup:)`에 전달합니다. 아직 seat와 dice가 없어도 table을 가진 game instance가 만들어집니다.

                @Code(name: "YachtGame.swift — game", file: 02-07-YachtGame-CreateGame.swift)
            }
        }
    }

    @Section(title: "테이블을 volume 바닥에 맞추기") {
        @ContentAndMedia {
            TabletopKit의 table space와 SwiftUI volume의 좌표는 별개입니다. root entity 전체를 이동하면 TabletopKit 장비의 상대 배치는 유지하면서 게임판만 원하는 위치로 옮길 수 있습니다.
        }

        @Steps {
            @Step {
                `GeometryReader3D`의 frame을 RealityKit scene 좌표로 변환합니다.

                @Code(name: "YachtGame.swift — scene frame", file: 02-08-Reposition-Frame.swift)
            }

            @Step {
                root의 y를 `frame.min.y`에 맞춰 테이블이 volume 바닥에 오도록 합니다. 현재 1m 테이블과 1m volume은 z 중심이 같으므로 `z: 0`을 사용합니다.

                @Code(name: "YachtGame.swift — translation", file: 02-09-Reposition-Translation.swift)
            }

            @Step {
                `RealityView`의 make와 update에서 같은 `repositionTable`을 호출해 volume의 위치 변화에도 배치를 다시 계산합니다.

                @Code(name: "ContentView.swift — reposition", file: 02-10-ContentView-Reposition.swift)
            }
        }
    }
}
