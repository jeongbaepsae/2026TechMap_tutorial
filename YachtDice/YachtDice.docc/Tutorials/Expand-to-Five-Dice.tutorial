@Tutorial(time: 15) {
    @Intro(title: "한 개의 장비를 다섯 개로 확장하기") {
        한 개의 `Die`가 정상적으로 보이는 것을 확인한 뒤 Yacht Dice에 필요한 다섯 개의 장비를 생성합니다.
    }

    @Section(title: "초기 위치가 겹치지 않게 만들기") {
        @ContentAndMedia {
            다섯 주사위가 모두 같은 `Pose2D`를 가지면 시작하자마자 서로 겹칩니다. index를 이용해 x축 간격을 계산합니다.
        }

        @Steps {
            @Step {
                `Die.init`에서 `spacing`과 `startX`를 정의합니다.

                @Code(name: "Die.swift — spacing", file: 05-01-Die-Spacing.swift)
            }

            @Step {
                index를 x 위치 계산에 사용해 각 주사위에 다른 초기 pose를 줍니다.

                @Code(name: "Die.swift — indexed pose", file: 05-02-Die-IndexedPose.swift)
            }
        }
    }

    @Section(title: "YachtGame이 다섯 주사위를 소유하게 하기") {
        @Steps {
            @Step {
                `dice: [Die]` 프로퍼티를 추가해 게임에서 같은 장비 인스턴스를 계속 참조할 수 있게 합니다.

                @Code(name: "YachtGame.swift — dice property", file: 05-03-Game-DiceProperty.swift)
            }

            @Step {
                `(1...5).map`으로 다섯 개의 `Die`를 생성합니다.

                @Code(name: "YachtGame.swift — create five", file: 05-04-Create-Five.swift)
            }

            @Step {
                생성된 모든 주사위를 `setup.add(equipment:)`로 등록합니다.

                @Code(name: "YachtGame.swift — add five", file: 05-05-Add-Five.swift)
            }
        }
    }
}
