@Tutorial(time: 35) {
    @Intro(title: "TabletopInteraction으로 한 개의 주사위 던지기") {
        interaction의 연결, controlled equipment 조회, phase 변화, toss 결과 반영을 한 단계씩 구현합니다.
    }

    @Section(title: "RealityView와 TabletopGame 연결하기") {
        @ContentAndMedia {
            `TabletopGame`을 생성했다고 해서 사용자의 gesture가 자동으로 game action이 되지는 않습니다. SwiftUI의 `.tabletopGame` modifier가 RealityKit scene과 TabletopKit interaction을 연결합니다.
        }

        @Steps {
            @Step {
                `ContentView`의 `RealityView` 뒤에 `.tabletopGame(game.tabletopGame, parent: game.root)`을 붙입니다.

                @Code(name: "ContentView.swift — tabletopGame", file: 06-01-ContentView-TabletopGame.swift)
            }

            @Step {
                interaction이 시작될 때 `DiceInteraction` delegate를 생성하도록 closure를 추가합니다.

                @Code(name: "ContentView.swift — delegate", file: 06-02-ContentView-Delegate.swift)
            }
        }
    }

    @Section(title: "사용자가 집은 장비 찾기") {
        @ContentAndMedia {
            interaction의 initial value에는 사용자가 제어하기 시작한 equipment ID가 있습니다. 이 ID를 실제 `Die` 인스턴스로 되찾습니다.
        }

        @Steps {
            @Step {
                `DiceInteraction`이 `TabletopInteraction.Delegate`를 채택하고 `game`을 저장합니다.

                @Code(name: "DiceInteraction.swift — delegate type", file: 06-03-Interaction-Type.swift)
            }

            @Step {
                `controlledEquipmentID`로 `TabletopGame.equipment(of:matching:)`을 호출해 `controlledDie`를 찾습니다.

                @Code(name: "DiceInteraction.swift — controlled die", file: 06-04-Controlled-Die.swift)
            }
        }
    }

    @Section(title: "interaction phase 관찰하기") {
        @ContentAndMedia {
            delegate의 `update(interaction:)`은 interaction의 생명주기를 여러 번 전달합니다. 먼저 `.started`, `.update`, `.ended`, `.cancelled`를 분리해서 아무 동작 없이 흐름을 확인합니다.
        }

        @Steps {
            @Step {
                `switch interaction.value.phase`를 만들고 각 phase case를 추가합니다.

                @Code(name: "DiceInteraction.swift — phases", file: 06-05-Interaction-Phases.swift)
            }
        }
    }

    @Section(title: "손을 놓았을 때 toss 요청하기") {
        @ContentAndMedia {
            `.update`는 한 번만 호출되는 이벤트가 아닙니다. gesture의 phase가 `.ended`가 되었는지 확인한 뒤 toss를 한 번만 요청합니다.
        }

        @Steps {
            @Step {
                gesture phase가 `.ended`인지 guard로 확인합니다.

                @Code(name: "DiceInteraction.swift — gesture end", file: 06-06-Gesture-End.swift)
            }

            @Step {
                `interaction.toss`에 controlled die의 ID와 `TossableRepresentation`을 전달합니다.

                @Code(name: "DiceInteraction.swift — toss", file: 06-07-Toss-One.swift)
            }
        }
    }

    @Section(title: "toss 결과를 장비 상태에 반영하기") {
        @ContentAndMedia {
            toss simulation이 계산한 결과는 `TossOutcome`으로 전달됩니다. outcome을 받았다고 화면의 장비 상태가 자동으로 영구 갱신되는 것은 아니므로 action을 추가합니다.
        }

        @Steps {
            @Step {
                `onTossStart`에서 outcome의 `restingOrientation`을 이용해 최종 face를 구합니다.

                @Code(name: "DiceInteraction.swift — face", file: 06-08-Toss-Face.swift)
            }

            @Step {
                `.updateEquipment` action으로 raw face와 최종 pose를 장비 상태에 반영합니다.

                @Code(name: "DiceInteraction.swift — updateEquipment", file: 06-09-Update-Equipment.swift)
            }
        }
    }
}
