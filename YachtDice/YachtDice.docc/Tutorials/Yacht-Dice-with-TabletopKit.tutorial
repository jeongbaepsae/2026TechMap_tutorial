@Tutorials(name: "Yacht Dice with TabletopKit") {
    @Intro(title: "TabletopKit으로 Yacht Dice 만들기") {
        RealityKit의 테이블과 주사위를 TabletopKit의 tabletop·장비로 연결하고, 사용자의 던지기 결과를 Yacht의 턴과 점수 상태로 이어 봅니다. 마지막에는 원하는 주사위를 고정하고 점수를 기록하며 한 판을 완료합니다. 아래 화면이 이 튜토리얼에서 완성할 Yacht Dice의 모습입니다.

        @Image(source: "9_Section 3_Step 1.png", alt: "완성된 Yacht Dice 앱의 테이블, 다섯 주사위, 점수표와 Game Complete 화면입니다.")
    }

    @Chapter(name: "1. 게임 공간 만들기") {
        @Image(source: chapter-tabletop.svg, alt: "볼륨 안에 원형 테이블이 놓인 이미지입니다.")

        visionOS 볼륨 프로젝트와 `RealityKitContent`의 테이블·D6 에셋을 준비한 뒤, TabletopKit이 사용할 tabletop과 플레이어 좌석를 연결합니다.

        @TutorialReference(tutorial: "doc:01-Prepare-the-Game-Space")
        @TutorialReference(tutorial: "doc:02-Build-the-Tabletop")
    }

    @Chapter(name: "2. 주사위와 인터랙션") {
        @Image(source: chapter-interaction.svg, alt: "테이블 위에서 주사위를 조작하는 이미지입니다.")

        D6 다섯 개를 장비로 올리고, 하나를 집으면 다섯 개가 함께 던져지도록 인터랙션을 구현합니다.

        @TutorialReference(tutorial: "doc:03-Add-Five-Dice")
        @TutorialReference(tutorial: "doc:04-Toss-the-Dice")
    }

    @Chapter(name: "3. Yacht 한 턴 만들기") {
        @Image(source: chapter-interaction.svg, alt: "주사위 다섯 개와 결과 패널을 나타낸 이미지입니다.")

        던지기 결과를 읽고 한 턴의 세 번 굴리기 규칙과 Hold를 연결합니다.

        @TutorialReference(tutorial: "doc:05-Read-Results-and-Limit-Rolls")
        @TutorialReference(tutorial: "doc:06-Hold-Dice")
    }

    @Chapter(name: "4. 점수표 완성하기") {
        @Image(source: chapter-scoring.svg, alt: "다섯 주사위 옆에 Yacht 점수표가 표시된 이미지입니다.")

        순수 Swift로 Yacht 점수를 계산하고, 점수를 기록한 뒤 보너스와 게임 종료까지 완성합니다.

        @TutorialReference(tutorial: "doc:07-Calculate-Yacht-Scores")
        @TutorialReference(tutorial: "doc:08-Record-Scores")
        @TutorialReference(tutorial: "doc:09-Finish-the-Game")
    }
}
